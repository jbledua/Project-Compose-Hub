# ---- Stack naming ----
STACK_NAME=homeassistant

# ---- Tailscale ----
# Create an auth key in the Tailscale admin console (ephemeral or reusable)
TS_AUTHKEY=tskey-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# How this node appears in your Tailnet
TS_HOSTNAME=homeassistant-ts

# ---- Home Assistant Web UI Port (exposed on the host through the TS sidecar) ----
# Default HA port is 8123; change if it conflicts on your host
PUBLIC_PORT=8123

# ---- General ----
# Use your local timezone for correct logs & automations
TIMEZONE=America/Toronto
